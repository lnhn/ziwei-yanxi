{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "紫微研习",
  "version": "0.1.0",
  "identifier": "com.renhuai.ziwei-yanxi",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "紫微研习 · 观天 察地 修人",
        "width": 1440,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 680,
        "maximized": true,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Light",
        "backgroundColor": "#FAF7F0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
